{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "job",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-03",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-cloudflare",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/__orbit/publish", "/__orbit/publish/*"]
  },
  "durable_objects": {
    "bindings": [{"name": "CATALOG_STORE", "class_name": "CatalogStore"}]
  },
  "exports": {
    "CatalogStore": {"type": "durable-object", "storage": "sqlite"}
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {"enabled": true, "invocation_logs": false},
    "traces": {"enabled": false}
  }
}
