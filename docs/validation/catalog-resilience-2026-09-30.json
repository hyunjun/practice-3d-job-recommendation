  "discussion": [
    {
      "issue": "Cancelling replacement projection on Saved navigation can reuse a different Worker's colliding revision number.",
      "foundBy": "astra",
      "main": "agreed and fixed by checking the published Worker owner before restoring its revision",
      "astra": "fix statically verified",
      "fable": "explicit agreement on owner fix; regression authored in test-authoring02",
      "testExecution": "new Saved-navigation regression passed in the initial DEV command; complete command failed in a separate startup-constructor case"
    },
    {
      "issue": "Pre-execution test review found paused presentation timers, possible request timeout during long clock jump, and an eventual-only own-deadline oracle.",
      "foundBy": [
        "main",
        "astra"
      ],
      "resolution": "Fable resumes/controls paused presentation clocks, releases obsolete/corrective replies separately, strengthens actual gesture gating, and adds pending-board/partial-compare cases; Astra rereview approved. The fetch timeout uses native AbortSignal.timeout, distinct from mocked page timers; no timeout failure was observed."
    },
    {
      "issue": "The test fixture accepted source sample although its public job factory excludes it.",
      "foundBy": "main",
      "resolution": "Fable narrowed the public override type before compilation; no compiler failure was observed."
    },
    {
      "issue": "First Fable authoring report described an early App/CityPanel state and counted E2E definitions rather than expanded width cases.",
      "resolution": "Original report retained; final plan must describe current source and actual expanded case counts. Not product test failures."
    },
    {
      "issue": "The existing startup-constructor test expected one finished initial HTTP request, but received none after the Worker failure aborted the response.",
      "observed": "Initial DEV:80passed/1failed,0skips/retries; exact request records:StrictMode abort(statusnull), then response abort(status202), both publicGET/noBody/net::ERR_ABORTED. Retry assertions were not reached.",
      "mainClassification": "Existing healthy-response oracle conflicts with the new constructor-failure cancellation lifecycle. Keep generic healthy helper strict and discuss a constructor-specific explicit transport oracle; no product fix or test edit made yet.",
      "astra": "Independently confirms cancellation is meaningful for an unread body; supports a constructor-specific positive signal oracle.",
      "fable": "Initially recommended removing the abort; withdrew after distinguishing headers from completed body. Proposed padding or direct observation; approved the observation alternative.",
      "decision": "CORRECTION_APPROVED",
      "resolution": "Keep product abort and shared healthy helper. Correct only startup scenario with same-attempt abort-after-headers/bodyUnused proof, bounded exact public requests, narrowly valid terminal orderings and unchanged recovery/privacy assertions.",
      "remaining": "Final DEV81passed including complete corrected startup retry; PROD and final verification agreement pending.",
      "claimLimits": "No buffer-bound, baseline resource leak, GC lifetime, transfer savings or immediate server-side cancellation was measured. Observer instrumentation has a scheduling footprint."
    },
    {
      "issue": "PROD has two global30s test timeouts with actual durations397147ms and208726ms.",
      "mainEvidence": "The revalidation case overlaps22:37:50–22:44:20KST Maintenance Sleep(390s); startup case overlaps22:45:45–22:49:14KST Maintenance Sleep(209s). Startup click trace spans207448.76ms, after positive cancellation and successful manualHTTP200 recovery.",
      "classification": "Main,Astra andFable agree on host-sleep interruption; preserve both failed tests and the failed command.",
      "proposedResolution": "Keep source,tests,assertions,timeouts,plan and build unchanged. After all3 approval, rerun all81PROD cases while an owned temporary sleep-prevention process is active.",
      "powerSettings": "Task-scoped caffeinate-i-s-t3600; no persistent or display/user-activity setting changes; stop explicitly before cleanup.",
      "evidenceSha256": "feb663bf886b61b1e7ca9027530ce0742e415fe2dddd68e8eaa7c7360c00d95a",
      "decision": "ENVIRONMENT_REVALIDATION_APPROVED",
      "independentTraceFinding": "Astra: revalidation accessibility frame.evaluate(axeRunPartial) waited388026.332ms across390s host sleep; final accessibility/focus/privacy assertions were not completed before the global timeout.",
      "revalidation": "FullPROD81passed on unchanged source/plan/build/assertions; no Sleep orDarkWake during the run. Both timed-out tests completed in this new run; earlier failures remain failures."
    }
